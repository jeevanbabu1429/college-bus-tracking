{
  "expo": {
    "name": "Bus",
    "slug": "bus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0e10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcollege.bustracking",
      "config": {
        "googleMapsApiKey": "AIzaSyAvCmL9l8PXps8b7wWCmavTuwjeoLpkfrs"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Bus to access your location while driving so students can see the bus on the map.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "89.116.134.28": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        }
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFCA0C"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAvCmL9l8PXps8b7wWCmavTuwjeoLpkfrs"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.yourcollege.bustracking",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Bus to use your location so drivers can share the bus position with students, and students can find the buses running near them."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bus to access your photos so you can set a profile picture."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
