MONGODB_URI=mongodb://localhost:27017/bus
PORT=4000
JWT_SECRET=replace-with-a-long-random-string

# --- Push notifications (Firebase Cloud Messaging) ---
# Optional. Without these the API boots fine but every push silently no-ops
# with one warning line, and the admin's Send notification page reports
# "Push is not switched on for this server".
#
# Pick ONE of the two forms.
#
# 1) Path to the service-account JSON downloaded from the Firebase console
#    (Project settings -> Service accounts -> Generate new private key):
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/bus-api/firebase-service-account.json
#
# 2) Or the three fields inline. Keep the literal \n escapes in the key —
#    they are converted to real newlines at load.
# FIREBASE_PROJECT_ID=bus-tracking-b644b
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@bus-tracking-b644b.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
