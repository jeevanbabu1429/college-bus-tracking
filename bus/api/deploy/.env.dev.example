# Copy to `.env.dev` and fill in. That file is gitignored and never leaves your
# machine except inside the deploy tarball — it is the manual replacement for
# the workflow's `${{ secrets.* }}` block.
#
#   cp deploy/.env.dev.example deploy/.env.dev

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# The VPS IP 89.116.134.28 must be allowlisted under Atlas → Network Access,
# or the app will fail to start. URL-encode any special characters in the
# password (@ → %40, # → %23, / → %2F).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bus_dev?retryWrites=true&w=majority

# Must match API_PORT in deploy.sh.
PORT=3030

# Generate a real one — this token signs every session:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# deploy.sh rewrites this to the absolute remote path automatically.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
