# Copy to `.env.production` and fill in. That file is gitignored and never
# leaves your machine — same role as deploy/.env.dev in bus/api.
#
#   cp deploy/.env.production.example deploy/.env.production
#
# ---------------------------------------------------------------------------
# EVERYTHING HERE IS BAKED INTO THE BUILD, NOT READ AT RUNTIME.
#
# Every variable is NEXT_PUBLIC_*, which Next.js substitutes as a literal
# string during `next build`. Changing a value therefore needs a full
# redeploy — `pm2 restart bus-website-dev` will keep serving the old value.
#
# It also means none of these may be a secret: they ship to every browser.
# ---------------------------------------------------------------------------

# Where the browser reaches the API. Must be a URL the *user's device* can
# resolve — not 127.0.0.1, which would point at the visitor's own machine.
NEXT_PUBLIC_API_URL=http://89.116.134.28:3030

# Web push (FCM). Optional: leave all seven blank and lib/firebase/config.ts
# reports the app as unconfigured, so notifications stay off and nothing
# breaks. Fill them all in or none — a partial set is treated as none.
# Values come from Firebase console -> Project settings -> Your apps -> Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging -> Web Push certificates -> Key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
